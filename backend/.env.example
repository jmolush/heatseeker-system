# Heatseeker Backend Configuration

# Local save path for captures (Chrome extension sends here)
CAPTURE_BASE_PATH=C:\heatseeker\captures

# Moomoo OpenD connection
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
OPEND_SECURITY_FIRM=FUTUINC

# Anthropic API (for Claude analysis)
ANTHROPIC_API_KEY=your-key-here

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5555

# Discord webhook (for alerts — optional, we can also go through OpenClaw)
DISCORD_WEBHOOK_URL=

# Feature flags
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
